# TMDB — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Force mock data even when TMDB_API_KEY is set (dev only)
# USE_MOCK_DATA=true

# Prisma (use a hosted Postgres URL in production — do not ship SQLite)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Site URL for metadata / Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Optional: bypass auth in local/dev when Clerk is disabled
# DEV_USER_ID=
