[32m+[m[32mconst debouncedQuery = useDebounce(query, 500);[m
[32m+[m
[32m+[m[32m// Effect only runs when debounced value changes[m
[32m+[m[32museEffect(() => {[m
[32m+[m[32m  performSearch(debouncedQuery);[m
[32m+[m[32m}, [debouncedQuery]);[m
[32m+[m[32m```[m
