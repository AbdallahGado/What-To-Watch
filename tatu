[32m+[m[32m### 1. Request Deduplication[m
[32m+[m[32m```typescript[m
[32m+[m[32m// Prevents duplicate concurrent API calls[m
[32m+[m[32mconst requestCache = new Map<string, Promise<any>>();[m
[32m+[m
[32m+[m[32m// Usage: Automatic in tmdbFetch()[m
[32m+[m[32m// - Same URL called twice = only one API request[m
[32m+[m[32m// - Results deduplicated for efficiency[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m### 2. Optimized Caching[m
[32m+[m[32m```typescript[m
[32m+[m[32m// QueryClient configuration[m
[32m+[m[32mstaleTime: 5 * 60 * 1000,      // 5 minutes[m
[32m+[m[32mgcTime: 30 * 60 * 1000,        // 30 minutes[m
[32m+[m[32mrefetchOnWindowFocus: false,   // Don't refetch on focus[m
[32m+[m[32mrefetchOnMount: false,          // Don't refetch on mount[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m### 3. Component Memoization[m
[32m+[m[32m```typescript[m
[32m+[m[32mexport const Component = memo(ComponentImpl, (prev, next) => {[m
[32m+[m[32m  // Custom comparison to prevent unnecessary re-renders[m
[32m+[m[32m  return prev.id === next.id && prev.value === next.value;[m
[32m+[m[32m});[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m### 4. Search Debouncing[m
[32m+[m[32m```typescript[m
